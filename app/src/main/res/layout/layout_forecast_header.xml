<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerRoot"
    android:layout_width="match_parent"
    android:layout_height="380dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_weather_gradient">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/tvForecastCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rajkot"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="34sp"/>

    <TextView
        android:id="@+id/tvForecastDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thursday, 16 July"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/imgForecastWeather"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tvForecastTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="31°"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="54sp"/>

    <TextView
        android:id="@+id/tvForecastCondition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patchy rain nearby"
        android:textColor="@android:color/white"
        android:textSize="24sp"/>

    <TextView
        android:id="@+id/tvForecastFeels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feels Like 34°"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>